# Kopieren nach .env und Werte anpassen (niemals echte Secrets committen)

POSTGRES_USER=scandypro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scandypro
DATABASE_URL=postgresql+asyncpg://scandypro:change-me@db:5432/scandypro

# Zufälligen Wert erzeugen, z.B. mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Feldweise Verschlüsselung (Wohlbefinden/Bewerbungen, siehe app/core/crypto.py).
# Erzeugen mit: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: Verlust dieses Schlüssels macht alle verschlüsselten Daten unlesbar - sicher aufbewahren,
# niemals rotieren ohne vorherige Neuverschlüsselung der Bestandsdaten (in dieser Version noch nicht automatisiert).
FIELD_ENCRYPTION_KEY=change-me-to-a-fernet-key

# Nur für lokale Prototyp-Phase: legt beim Start Demo-Nutzer an, falls DB leer ist.
# In echten Einrichtungen IMMER auf false setzen.
SEED_DEMO_DATA=true

# Optional: legt beim Start einen ersten Einrichtungs-Admin an, falls noch
# keiner mit dieser E-Mail existiert (siehe app/core/seed.py:seed_admin) -
# für echten Betrieb OHNE SEED_DEMO_DATA. Beide Werte leer lassen, um den
# Bootstrap zu überspringen. Nach dem ersten erfolgreichen Login ADMIN_PASSWORD
# hier am besten wieder entfernen (liegt sonst dauerhaft im Klartext).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# HTTP-Port, unter dem die App über Caddy erreichbar ist (siehe compose.yaml).
# Bei Parallelbetrieb mehrerer Stacks auf demselben Host pro Stack anpassen.
# Gilt nur für den TLS-losen Standard-Betrieb per IP/lokal - bei echter
# Domain mit HTTPS (caddy/Caddyfile.domain-example) übernehmen feste Ports
# 80/443 diese Rolle, bei rein internem HTTPS ohne Domain
# (caddy/Caddyfile.internal-tls-example) APP_HTTPS_PORT unten.
APP_PORT=8080

# Nur relevant bei caddy/Caddyfile.internal-tls-example (selbstsigniertes
# HTTPS fürs interne Netz, ohne öffentliche Domain) - Port, unter dem die
# App dann per HTTPS erreichbar ist, z.B. https://<server-ip>:8443.
APP_HTTPS_PORT=8443

# Session-Cookie mit Secure-Flag senden - erst auf true setzen, NACHDEM auf
# HTTPS umgestellt wurde (egal ob per echter Domain oder selbstsigniert für
# das interne Netz - siehe README.md "TLS (Produktivbetrieb)"). Bei false
# (Standard) funktioniert der Login weiterhin über HTTP, aber das Cookie
# ist dabei nicht gegen Mitlesen im Netz geschützt.
SESSION_COOKIE_SECURE=false

# Optional: Single Sign-On über einen OIDC-Provider (z.B. Authentik) -
# vollständige Anleitung in SSO_AUTHENTIK.md. Nur aktiv, wenn alle drei
# OIDC_*-Werte gesetzt sind; leer lassen, um SSO auszulassen (lokales
# E-Mail/Passwort-Login bleibt in jedem Fall verfügbar).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
